#!/usr/bin/env sh
# Portable launcher: scripts/ccfa <command> [args...]
#
# The PowerShell wrappers in this directory stay the Windows entry point; this
# launcher is the POSIX equivalent, and both forward to the same dispatcher so
# they run the identical Python code path.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ -x "$root/tools/.venv/bin/python" ]; then
    python="$root/tools/.venv/bin/python"
elif [ -x "$root/tools/.venv/Scripts/python.exe" ]; then
    python="$root/tools/.venv/Scripts/python.exe"
else
    python="${PYTHON:-python3}"
fi

tools_dir="$root/tools"
sep=:
# Git Bash/Cygwin hand a POSIX path to a native python.exe, which cannot resolve
# it in an environment variable, and use ';' between PYTHONPATH entries.
case "$(uname -s 2>/dev/null || echo unknown)" in
    MINGW* | MSYS* | CYGWIN*)
        sep=';'
        if command -v cygpath >/dev/null 2>&1; then
            tools_dir=$(cygpath -w "$tools_dir")
        fi
        ;;
esac

PYTHONPATH="$tools_dir${PYTHONPATH:+$sep$PYTHONPATH}"
export PYTHONPATH
exec "$python" -m ccfa "$@"
