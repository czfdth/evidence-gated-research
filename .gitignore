*.pyc
# Tool caches and plugin scratch state; all regenerable, never evidence.
.ruff_cache/
.pytest_cache/
.superpowers/
/repro-bundle.out.json
# Root-level ad-hoc command captures from manual verification. Durable evidence
# belongs under reviews/ or a paper repository's ccfa-workfiles/.
/*.err.txt
/*-check.json
/argument-audit.json
/readiness-*.json
/runlog-migration.out.json
/verify-all.out.json
/ccfa-workfiles/
# PyInstaller output for the workbench installer (app/ccfa-workbench.spec).
# Generated, large, and never a source of truth; rebuild with
# scripts/build-workbench.ps1.
/build/
/dist/
